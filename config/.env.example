# BMG OAuth sidecar 的本地配置。不要把 config/.env 提交到 Git。
BMG_SIDECAR_HOST=127.0.0.1
BMG_SIDECAR_PORT=18007
BMG_UPSTREAM_URL=http://127.0.0.1:12306
# Replace the hostname with the HTTPS origin that exposes this gateway (for example a Tailscale Funnel hostname).
BMG_ISSUER=https://your-machine.your-tailnet.ts.net/bmg
BMG_RESOURCE=https://your-machine.your-tailnet.ts.net/bmg/mcp
BMG_STATE_FILE=.state/bmg-oauth-state.json
BMG_UPSTREAM_SESSION_FILE=.state/bmg-upstream-session.json
BMG_APPROVAL_SECRET_FILE=.state/bmg-approval-secret.txt
BMG_LOG_DIR=logs
BMG_TOKEN_TTL_SECONDS=3600

# Optional GPT-dedicated Edge workspace. When enabled, page-directed tools are
# pinned to one unfocused Edge window/tab instead of the user's foreground window.
BMG_WORKSPACE_MODE=0
BMG_WORKSPACE_STATE_FILE=.state/bmg-workspace.json
# Close every tab in the dedicated BMG workspace after this many idle seconds. 0 disables cleanup.
BMG_WORKSPACE_IDLE_TIMEOUT_SECONDS=1800
